    "This feature is disabled in hardcore mode. Please disable hardcore mode in the RetroAchievements settings to use this feature.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is disabled in hardcore mode. Please disable hardcore mode in the RetroAchievements settings to use this feature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función está deshabilitada en el modo hardcore. Desactiva el modo hardcore en la configuración de RetroAchievements para usar esta función."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はハードコアモードでは無効です。この機能を使用するには、RetroAchievements設定でハードコアモードを無効にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
