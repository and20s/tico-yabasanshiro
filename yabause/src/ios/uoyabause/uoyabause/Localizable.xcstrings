    "For security reasons, please re-enter your password to delete your account.": {
      "comment": "Message for reauthentication",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security reasons, please re-enter your password to delete your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por razones de seguridad, vuelva a ingresar su contraseña para eliminar su cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティのため、アカウントを削除するにはパスワードを再入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por motivos de segurança, digite novamente sua senha para excluir sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях безопасности повторно введите пароль для удаления аккаунта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出于安全原因，请重新输入密码以删除您的账户。"
          }
        }
      }
    },
    "For security reasons, you need to sign in again to delete your account. Please sign out and sign in again, then retry.": {
      "comment": "Message for reauthentication required",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security reasons, you need to sign in again to delete your account. Please sign out and sign in again, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por razones de seguridad, debe iniciar sesión nuevamente para eliminar su cuenta. Por favor, cierre sesión e inicie sesión de nuevo, luego vuelva a intentar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティ上の理由から、アカウントを削除するには再度ログインする必要があります。一度ログアウトして再度ログインした後、再試行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por motivos de segurança, você precisa fazer login novamente para excluir sua conta. Por favor, saia e entre novamente, depois tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях безопасности для удаления аккаунта необходимо войти заново. Пожалуйста, выйдите и войдите снова, затем повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出于安全原因，您需要重新登录才能删除账户。请退出并重新登录，然后重试。"
          }
        }
      }
    },
    "For your security, sign out and sign in again before deleting your account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, sign out and sign in again before deleting your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, cierra sesión y vuelve a iniciarla antes de eliminar tu cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全のため、アカウントを削除する前に一度サインアウトして、もう一度サインインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por segurança, saia e entre novamente antes de excluir sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях безопасности выйдите и войдите снова перед удалением аккаунта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了安全，请先退出登录并重新登录，然后再删除账号。"
          }
        }
      }
    },
