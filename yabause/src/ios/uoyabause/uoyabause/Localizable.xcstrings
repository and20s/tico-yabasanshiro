    "This deletes your account and all of its data. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your account and all of its data. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta y todos sus datos. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとすべてのデータを削除します。元に戻すことはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto exclui sua conta e todos os seus dados. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт и все его данные будут удалены. Отменить это нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除你的账号及其所有数据，且无法撤销。"
          }
        }
      }
    },
    "This feature is available when you sign in with Google.": {
      "extractionState": "manual",
