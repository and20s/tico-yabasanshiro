          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações de %@ ativadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления %@ включены"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@通知已启用"
          }
        }
      }
    },
    "%@ save data shared": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ save data shared"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de guardado de %@ compartidos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のセーブデータを共有しました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados salvos de %@ compartilhados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение %@ опубликовано"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分享 %@ 的存档"
          }
        }
      }
    },
    "%@ will be available in a future update": {
      "comment": "Coming soon message",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be available in a future update"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estará disponible en una futura actualización"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は将来のアップデートで利用可能になります"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estará disponível em uma atualização futura"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ будет доступно в будущем обновлении"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@将在未来的更新中提供"
          }
        }
      }
    },
