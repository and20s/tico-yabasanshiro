    "A game title is required so others can find this save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game title is required so others can find this save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita el título del juego para que otros encuentren esta partida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人が見つけられるよう、ゲームタイトルの入力が必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título do jogo é necessário para que outros encontrem este save."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название игры обязательно, иначе другие не найдут это сохранение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要填写游戏标题，其他人才能找到这个存档。"
          }
        }
      }
    },
    "A game title is required.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game title is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita el título del juego."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームタイトルを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título do jogo é obrigatório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите название игры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写游戏标题。"
          }
        }
      }
    },
    "A save with this name already exists. Overwrite it?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save with this name already exists. Overwrite it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una partida guardada con este nombre. ¿Sobrescribirla?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のセーブがすでにあります。上書きしますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um save com este nome. Substituir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение с таким именем уже существует. Перезаписать?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名存档。要覆盖吗？"
          }
        }
      }
    },
