    "Sign in to your RetroAchievements account to unlock achievements and compete on leaderboards.": {
      "comment": "Description for RetroAchievements login",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your RetroAchievements account to unlock achievements and compete on leaderboards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de RetroAchievements para desbloquear logros y competir en las tablas de clasificación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RetroAchievementsアカウントにサインインして、実績をアンロックしリーダーボードで競いましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na sua conta RetroAchievements para desbloquear conquistas e competir nos rankings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в свою учетную запись RetroAchievements, чтобы разблокировать достижения и соревноваться в таблицах лидеров."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录您的RetroAchievements账户以解锁成就并在排行榜上竞争。"
          }
        }
      }
    },
