          }
        }
      }
    },
    "This only changes what you see, and you can undo it from the community list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only changes what you see, and you can undo it from the community list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia lo que tú ves, y puedes deshacerlo desde la lista de la comunidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
