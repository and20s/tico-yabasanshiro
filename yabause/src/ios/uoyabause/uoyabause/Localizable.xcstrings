    "Sharing uploads this save so anyone can find and download it from the community list, not only people who have the link.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing uploads this save so anyone can find and download it from the community list, not only people who have the link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al compartirla, cualquiera podrá encontrarla y descargarla desde la lista, no solo quien tenga el enlace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開すると、リンクを知っている人だけでなく、誰でも一覧から見つけてダウンロードできるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao compartilhar, qualquer pessoa poderá encontrar e baixar este save na lista, não apenas quem tem o link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После публикации сохранение сможет найти и скачать любой из списка, а не только тот, у кого есть ссылка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开后，任何人都能在列表中找到并下载，而不仅仅是拿到链接的人。"
          }
        }
      }
    },
