    "report_notice": {
      "comment": "Notice text for the report dialog",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps us improve the emulator. Please rate both the game and the emulation quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus comentarios nos ayudan a mejorar el emulador. Por favor, califique tanto el juego como la calidad de la emulación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのフィードバックはエミュレータの改善に役立ちます。ゲームとエミュレーションの品質を評価してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu feedback nos ajuda a melhorar o emulador. Por favor, avalie tanto o jogo quanto a qualidade da emulação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш отзыв помогает нам улучшить эмулятор. Пожалуйста, оцените игру и качество эмуляции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的反馈有助于我们改进模拟器。请同时评价游戏和模拟质量。"
          }
        }
      }
    },
    "report_sent_success": {
      "comment": "Report sent successfully message",
