          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta función está deshabilitada en el modo hardcore. Desactiva el modo hardcore en la configuración de RetroAchievements para usar esta función."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この機能はハードコアモードでは無効です。この機能を使用するには、RetroAchievements設定でハードコアモードを無効にしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este recurso está desativado no modo hardcore. Desative o modo hardcore nas configurações do RetroAchievements para usar este recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта функция отключена в хардкорном режиме. Отключите хардкорный режим в настройках RetroAchievements, чтобы использовать эту функцию."
          }
