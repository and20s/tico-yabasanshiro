    "The free version holds three games. A subscription removes the limit.": {
      "comment": "Reason the pro gate opened from the game limit",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version holds three games. A subscription removes the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita permite tres juegos. La suscripción quita el límite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版はゲーム 3 本までです。サブスクリプションで上限がなくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita permite três jogos. A assinatura remove o limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии три игры. Подписка снимает ограничение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版最多 3 个游戏。订阅后取消此限制。"
          }
        }
      }
    },
    "Cloud backup needs a subscription or the full version.": {
      "comment": "Reason the pro gate opened from cloud backup",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud backup needs a subscription or the full version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia en la nube requiere una suscripción o la versión completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドバックアップにはサブスクリプションか通常版が必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup na nuvem exige uma assinatura ou a versão completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для облачного копирования нужна подписка или полная версия."
          }
        },
