<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RadioGroup
            android:id="@+id/radio_group_bios_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_builtin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bios_type_builtin"
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <RadioButton
                android:id="@+id/radio_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bios_type_file"
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/layout_file_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- List of available BIOS files -->
            <TextView
                android:id="@+id/text_bios_list_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/available_bios_files"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Container for BIOS file items (dynamically populated) -->
            <LinearLayout
                android:id="@+id/container_bios_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/text_no_bios_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_bios_files"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/button_add_bios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_bios_file"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_extended_memory_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/extended_memory_disabled_notice"
            android:textSize="12sp"
            android:textColor="@color/colorWarning"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
