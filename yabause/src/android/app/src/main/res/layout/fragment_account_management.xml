<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.uoyabause.android.auth.ui.AccountManagementFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/account_management_title"
            app:navigationIcon="@drawable/ic_arrow_back_24" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/loading_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/loading_account_data"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

            </LinearLayout>

            <!-- Error State / Not Authenticated State -->
            <LinearLayout
                android:id="@+id/error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/error_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_error_outline_24"
                    android:contentDescription="@string/error_icon"
                    app:tint="?attr/colorError" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/error_loading_account_data"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textAlignment="center" />

                <!-- Benefits Section (shown only for NotAuthenticated state) -->
                <LinearLayout
                    android:id="@+id/benefits_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/margin_small">

                    <!-- Benefits List in Compact Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="@dimen/card_elevation"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        android:layout_marginBottom="@dimen/margin_small">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_account_benefits_title"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                android:layout_marginBottom="@dimen/margin_small" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_benefit_cloud_backup"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_marginBottom="@dimen/margin_tiny" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_benefit_action_replay"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_marginBottom="@dimen/margin_tiny" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_benefit_leaderboard"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_marginBottom="@dimen/margin_tiny" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/main_benefit_sync"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/sign_in" />

            </LinearLayout>

            <!-- Main Content -->
            <LinearLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- User Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/user_profile_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:cardCornerRadius="@dimen/card_corner_radius_medium"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/card_stroke_width">

                    <include layout="@layout/card_user_profile" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Connected Accounts Section -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/connected_accounts"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <!-- Empty state hint (shown when both accounts are disconnected) -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/connected_accounts_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/connected_accounts_empty_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <!-- Connected Accounts Card (Discord + RetroAchievements) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:cardCornerRadius="@dimen/card_corner_radius_medium"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/card_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Discord Account Section -->
                        <LinearLayout
                            android:id="@+id/discord_account_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include layout="@layout/card_discord_account" />

                        </LinearLayout>

                        <!-- Divider -->
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_medium"
                            android:layout_marginEnd="@dimen/margin_medium" />

                        <!-- RetroAchievements Account Section -->
                        <LinearLayout
                            android:id="@+id/retroachievements_account_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include layout="@layout/card_retroachievements_account" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Account Actions Section -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/account_actions_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/account_actions"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <!-- Cross-Device Sync Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cross_device_sync_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:cardCornerRadius="@dimen/card_corner_radius_medium"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/card_stroke_width">

                    <include layout="@layout/card_cross_device_sync" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Data Export Card -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/data_export_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:cardCornerRadius="@dimen/card_corner_radius_medium"
                    android:visibility="gone"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="@dimen/card_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingEnd="28dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_download_24"
                            android:contentDescription="@string/export_data_icon"
                            app:tint="?attr/colorAccent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/export_data"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/export_data_description"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/export_data_button"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_medium"
                            android:text="@string/export" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Account Deletion Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/account_deletion_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/card_corner_radius_medium"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="?attr/colorError"
                    app:strokeWidth="@dimen/card_stroke_width"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingEnd="28dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_delete_24"
                            android:contentDescription="@string/delete_account_icon"
                            app:tint="?attr/colorError" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/delete_account"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorError" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/delete_account_description"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/delete_account_button"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_medium"
                            android:text="@string/delete"
                            app:strokeColor="?attr/colorError"
                            android:textColor="?attr/colorError" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Privacy Policy and Terms of Service (single location) -->
            <LinearLayout
                android:id="@+id/privacy_terms_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_small">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_terms_description"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_marginEnd="@dimen/margin_tiny" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/privacy_policy_link_footer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_policy_link"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="@dimen/margin_tiny" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&amp;"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_marginEnd="@dimen/margin_tiny" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/terms_of_service_link_footer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_of_service_link"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
