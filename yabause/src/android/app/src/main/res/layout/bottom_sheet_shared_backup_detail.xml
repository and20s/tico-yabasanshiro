<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Drag handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="?attr/colorOnSurfaceVariant" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <!-- Large screenshot -->
            <ImageView
                android:id="@+id/iv_screenshot_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/screenshot"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save" />

            <!-- Game title -->
            <TextView
                android:id="@+id/tv_game_title_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Sonic R" />

            <!-- Filename -->
            <TextView
                android:id="@+id/tv_filename_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                tools:text="SONIC_R" />

            <!-- Divider -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp" />

            <!-- Description (shared by the owner) -->
            <TextView
                android:id="@+id/tv_description_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="100% Complete - All characters unlocked" />

            <!-- Original backup comment -->
            <TextView
                android:id="@+id/tv_comment_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="SONIC_R_DATA01" />

            <!-- Divider -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp" />

            <!-- Owner row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Owner photo -->
                <ImageView
                    android:id="@+id/iv_owner_photo_detail"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/user_avatar_description"
                    android:src="@drawable/ic_account_circle_24" />

                <!-- Owner name -->
                <TextView
                    android:id="@+id/tv_owner_name_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="SaturnFan123" />

            </LinearLayout>

            <!-- Meta info row: rating + downloads + shared date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Rating star -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:contentDescription="@string/sort_by_rating"
                    android:src="@drawable/ic_star"
                    app:tint="@color/colorRating" />

                <TextView
                    android:id="@+id/tv_rating_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="4.5 (12)" />

                <!-- Downloads -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:contentDescription="@string/import_backup"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_downloads_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="156" />

                <!-- Shared date -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:contentDescription="@string/shared_date"
                    android:src="@drawable/ic_calendar"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_shared_date_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="2024/12/01" />

            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Delete button (owner only) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_detail"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:text="@string/delete"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete_24"
                    app:iconTint="?attr/colorError"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Share link button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_detail"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/share_backup"
                    android:focusable="true"
                    app:icon="@drawable/ic_share_24" />

                <!-- Rate button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rate_detail"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:text="@string/rate_button"
                    app:icon="@drawable/ic_star_outline" />

                <!-- Import button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:focusable="true"
                    android:text="@string/import_backup"
                    app:icon="@drawable/ic_download" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
