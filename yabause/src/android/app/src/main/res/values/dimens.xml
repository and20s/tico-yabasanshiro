<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">2dp</dimen>
    <dimen name="activity_vertical_margin">2dp</dimen>
    <dimen name="nav_header_vertical_spacing">8dp</dimen>
    <dimen name="nav_header_height">60dp</dimen>
    <!-- M3 Spacing System (4dp grid) -->
    <dimen name="margin_tiny">4dp</dimen>
    <dimen name="margin_small">8dp</dimen>
    <dimen name="margin_medium">10dp</dimen>
    <dimen name="margin_large">32dp</dimen>
    <dimen name="margin_huge">64dp</dimen>

    <!-- Additional M3 spacing tokens -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">16dp</dimen>
    <dimen name="spacing_l">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>
    <dimen name="spacing_xxl">48dp</dimen>

    <!-- Component-specific dimensions -->
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="text_margin">16dp</dimen>

    <!-- M3 Component dimensions -->
    <dimen name="card_corner_radius_medium">12dp</dimen>
    <dimen name="card_corner_radius_small">8dp</dimen>
    <dimen name="card_corner_radius_large">16dp</dimen>
    <dimen name="card_stroke_width">1dp</dimen>
    <dimen name="card_stroke_width_focused">2dp</dimen>
    <dimen name="card_elevation">1dp</dimen>

    <!-- Minimum touch target size (M3 accessibility requirement) -->
    <dimen name="min_touch_target">48dp</dimen>

    <!-- Legacy - kept for backward compatibility -->
    <dimen name="card_corner_radius">5dp</dimen>
    <dimen name="card_stroke_width_outlined">1dp</dimen>
</resources>
