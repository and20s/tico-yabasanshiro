<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="org.uoyabause.android.backup.ui.BackupManagerFragment">

    <!-- Toolbar (no TabLayout in landscape) -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_backup_manager"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:focusable="false"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/backup_manager">

            <!-- Search and Sort buttons in toolbar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:contentDescription="@string/search_backup"
                    android:focusable="true"
                    app:icon="@drawable/baseline_search_24"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sort"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:contentDescription="@string/sort_backups"
                    android:focusable="true"
                    app:icon="@drawable/baseline_sort_24"
                    app:iconTint="?attr/colorOnSurface" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Collapsible search bar container -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_small"
            android:paddingVertical="@dimen/margin_tiny"
            android:background="?attr/colorSurface"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/spacing_l"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/search_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:iconifiedByDefault="false"
                    app:queryHint="@string/search_backup" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_search"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:contentDescription="@string/cancel"
                android:focusable="true"
                app:icon="@drawable/baseline_close_24"
                app:iconTint="?attr/colorOnSurface" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- NavigationRail + Content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/navigation_rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainer"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_backup_navigation" />

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Progress indicator for operations -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

</LinearLayout>
