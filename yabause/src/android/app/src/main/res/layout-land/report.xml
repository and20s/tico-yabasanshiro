<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Left Column: Ratings and Attachments -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/review_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textStyle="italic"
                    android:textSize="12sp"/>

                <!-- Emulation Rating -->
                <LinearLayout
                    android:id="@+id/emulation_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/emulation_status"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="EMULATION:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_gravity="center_vertical"/>

                    <RatingBar
                        android:id="@+id/emulation_ratingBar"
                        style="@android:style/Widget.DeviceDefault.Light.RatingBar.Indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:isIndicator="false"
                        android:scaleX="0.7"
                        android:scaleY="0.7"
                        android:transformPivotX="0dp"
                        android:transformPivotY="12dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/emulation_rateString"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Large Text"
                    android:textSize="12sp"/>

                <!-- Game Rating -->
                <LinearLayout
                    android:id="@+id/game_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="GAME:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_gravity="center_vertical"/>

                    <RatingBar
                        android:id="@+id/game_ratingBar"
                        style="@android:style/Widget.DeviceDefault.Light.RatingBar.Indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:isIndicator="false"
                        android:scaleX="0.7"
                        android:scaleY="0.7"
                        android:transformPivotX="0dp"
                        android:transformPivotY="12dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/game_rateString"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Large Text"
                    android:textSize="12sp"/>

                <!-- Attachment Options -->
                <LinearLayout
                    android:id="@+id/attachment_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/screenshot_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/report_include_screenshot"
                        android:textSize="12sp"
                        android:checked="false"
                    />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/reproduction_data_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/report_include_reproduction_data"
                        android:textSize="12sp"
                        android:checked="false"
                    />

                    <TextView
                        android:id="@+id/attachment_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_estimated_size"
                        android:textSize="10sp"
                        android:paddingTop="4dp"
                        android:visibility="gone"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Right Column: Preview and Input -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- Screenshot Preview -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/screenshot_preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_screenshot_preview"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:paddingBottom="4dp"/>

                        <ImageView
                            android:id="@+id/screenshot_preview"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="fitCenter"
                            android:background="@android:color/black"
                            android:contentDescription="@string/report_screenshot_preview"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Input and Send Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/input_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp">

                        <EditText
                            android:id="@+id/report_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/issue_report"
                            android:inputType="textMultiLine"
                            android:maxLines="4"
                            android:minHeight="48dp"
                            android:padding="12dp"
                            android:textSize="14sp"/>

                    </androidx.cardview.widget.CardView>

                    <ImageButton
                        android:id="@+id/send_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_send"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
